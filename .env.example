# =============================================================================
# InfluxDB Configuration
# =============================================================================
INFLUX_ADMIN_USER=admin
# Required: generate a unique value with openssl rand -hex 32.
INFLUX_ADMIN_PASSWORD=
INFLUX_ORG=home
INFLUX_BUCKET=inverter
# Required: generate separately with openssl rand -hex 32.
INFLUX_TOKEN=

# Use this if connecting to external InfluxDB instead of local container
# INFLUX_URL=http://your-influxdb-host:8086

# =============================================================================
# Grafana Configuration
# =============================================================================
GRAFANA_ADMIN_USER=admin
# Required: generate separately with openssl rand -hex 32.
GRAFANA_ADMIN_PASSWORD=
# Anonymous viewing is disabled unless deliberately enabled.
GRAFANA_ANONYMOUS_ENABLED=false

# =============================================================================
# MQTT Broker (Cerbo GX IP address)
# =============================================================================
MQTT_HOST=your-cerbo-ip-here

# =============================================================================
# GitHub Webhook (for auto-deploy via Argo tunnel)
# =============================================================================
# Generate with: openssl rand -hex 32
# Required only when enabling the optional webhook; keep separate from other secrets.
WEBHOOK_SECRET=

# Published ports are local-only by default. See docs/secure-deployment.md before changing.
MONITORING_BIND_ADDRESS=127.0.0.1
